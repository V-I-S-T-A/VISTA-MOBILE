{
  "name": "vista-app",
  "version": "1.0.5",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:railway": "node scripts/start-railway.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "knip": "knip",
    "postinstall": "node scripts/apply-native-patches.js",
    "lint": "eslint . --max-warnings 0",
    "validate:project": "node scripts/ci/validate-project.cjs",
    "validate:expo": "expo config --type public && expo install --check",
    "test": "node scripts/ci/run-tests.cjs",
    "test:push": "npm test",
    "bundle:android:ci": "expo export:embed --entry-file node_modules/expo/AppEntry.js --platform android --dev false --minify true --max-workers 2 --bundle-output dist/ci/index.android.bundle --assets-dest dist/ci/assets",
    "audit:ci": "node scripts/ci/audit-dependencies.cjs",
    "audit:versions": "npm audit --package-lock-only --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.6",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/parser": "^7.29.14",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "knip": "^6.24.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss": "8.5.33",
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-splash-screen"
        ]
      }
    }
  },
  "private": true
}
