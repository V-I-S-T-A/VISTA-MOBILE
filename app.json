{
  "expo": {
    "name": "VISTA",
    "scheme": "vista-app",
    "slug": "vista-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/vista-logo.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/vista-logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/vista-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wayvbb.vistaapp"
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "react-native-document-scanner-plugin",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "42779503-b7fd-40a9-b7ae-fed66a9c646e"
      }
    },
    "owner": "purplehouse"
  }
}
