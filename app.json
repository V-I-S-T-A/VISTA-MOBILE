{
  "expo": {
    "name": "VISTA",
    "scheme": "vista-app",
    "slug": "vista-app",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/native/app-icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/native/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/native/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wayvbb.vistaapp"
    },
    "web": {
      "favicon": "./src/assets/logo.webp"
    },
    "plugins": [
      "expo-notifications",
      "react-native-document-scanner-plugin",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/native/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "42779503-b7fd-40a9-b7ae-fed66a9c646e"
      }
    },
    "owner": "purplehouse"
  }
}
